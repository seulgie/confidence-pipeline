# --- MinIO (matches docker-compose.yml defaults) --------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_STAGED=staged

# --- STAC endpoints -------------------------------------------------------
# Planetary Computer — hosts Sentinel-1 RTC and Sentinel-2 L2A; needs signing.
STAC_ENDPOINT_PC=https://planetarycomputer.microsoft.com/api/stac/v1
# Element 84 Earth Search — open, no auth, Sentinel-2 L2A only.
STAC_ENDPOINT_ES=https://earth-search.aws.element84.com/v1

# --- Airflow --------------------------------------------------------------
# Keep Airflow metadata inside the repo (git-ignored under .airflow/) so the
# home dir stays clean. Comment out to fall back to ~/airflow.
AIRFLOW_HOME=${PWD}/.airflow